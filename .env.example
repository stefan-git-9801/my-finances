# Copy to .env for local Podman development.

POSTGRES_USER=myfinances
POSTGRES_PASSWORD=myfinances
POSTGRES_DB=myfinances

# Used by the `api` container in compose.yaml.
ASPNETCORE_ENVIRONMENT=Development

# When running the API on the host (dotnet run) this is read from
# backend/src/MyFinances.Api/appsettings.Development.json instead.
