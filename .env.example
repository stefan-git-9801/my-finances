# Copy to .env for local Podman development.

POSTGRES_USER=myfinances
POSTGRES_PASSWORD=myfinances
POSTGRES_DB=myfinances

# Used by the `api` container in compose.yaml.
ASPNETCORE_ENVIRONMENT=Development

# The single application user, created on first start if it does not exist yet.
# (When running the API on the host with ASPNETCORE_ENVIRONMENT=Development this is
# read from appsettings.Development.json instead.)
ADMIN_EMAIL=dev@my-finances.local
ADMIN_PASSWORD=DevPass123

# When running the API on the host (dotnet run) this is read from
# backend/src/MyFinances.Api/appsettings.Development.json instead.
